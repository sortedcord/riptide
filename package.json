{
  "name": "riptide",
  "private": true,
  "workspaces": [
    "shops/*",
    "engine",
    "console"
  ],
  "scripts": {
    "dev:market": "npm run dev -w shops/market",
    "dev:food": "npm run dev -w shops/food",
    "dev:air": "npm run dev -w shops/air",
    "dev:saas": "npm run dev -w shops/saas",
    "dev:ott": "npm run dev -w shops/ott",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "playwright test",
    "riptide": "tsx --env-file-if-exists=.env engine/cli.ts",
    "console": "npm run dev -w console"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
