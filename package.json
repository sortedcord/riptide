{
  "name": "riptide",
  "private": true,
  "workspaces": [
    "shops/*",
    "engine",
    "console"
  ],
  "scripts": {
    "dev:market": "npm run dev -w shops/market",
    "dev:food": "npm run dev -w shops/food",
    "dev:air": "npm run dev -w shops/air",
    "dev:saas": "npm run dev -w shops/saas",
    "dev:ott": "npm run dev -w shops/ott",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "playwright test",
    "riptide": "tsx --env-file-if-exists=.env engine/cli.ts",
    "console": "npm run dev -w console",
    "readme:headings": "node docs/assets/headings/render.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "opentype.js": "1.3.4"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-client": "1.1.0",
    "@earendil-works/pi-protocol": "1.1.0",
    "@earendil-works/pi-server": "1.1.0",
    "@earendil-works/chord": "1.1.0"
  }
}
